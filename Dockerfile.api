# ---- Étape 1 : entraîner le modèle (models/spam_model.joblib n'est pas suivi par Git) ----
FROM python:3.12-slim AS train

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1

COPY requirements-api.txt .
RUN python -m pip install -r requirements-api.txt pandas

COPY src ./src
COPY data/processed ./data/processed
RUN python src/train_model.py


# ---- Étape 2 : image finale de l'API ----
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

COPY requirements-api.txt .
RUN python -m pip install -r requirements-api.txt

COPY api ./api
COPY --from=train /app/models/spam_model.joblib models/spam_model.joblib

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
